# 谛听 · 环境变量配置
# 复制此文件为 .env 并填入真实值

# === 运行层级 ===
DITING_LEVEL=L1

# === 数据源 ===
MX_APIKEY=your_m...n
# === AI（LiteLLM — 统一 100+ provider） ===
AI_MODEL=deepseek/deepseek-v4-pro
AI_API_KEY=your_a...e

# === 沙箱（sandboxmcp） ===
SANDBOX_BACKEND=process
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT=60
SANDBOX_ALLOWED_IMPORTS=numpy,pandas,scipy,vmdpy,PyWavelets,PyEMD,openpyxl

# === 推送 ===
NOTIFY_DEFAULT=local

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=*** 邮件
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# === 缓存 ===
CACHE_REALTIME_TTL=3600
CACHE_HISTORICAL_TTL=86400
