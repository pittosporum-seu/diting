# Diting v0.8 environment template. Never commit a populated copy.

# Runtime and durable paths
DITING_ENVIRONMENT=production
DITING_PUBLIC_READONLY=true
DITING_LOG=WARNING
DITING_DB_PATH=/var/lib/diting/diting.db
DITING_CACHE_DB_PATH=/var/lib/diting/diting_cache.db
DITING_REPORT_OUTPUT_DIR=/var/lib/diting/reports

# Owner security (replace placeholders in /etc/diting/env)
# Generate the password hash with the project auth helper; keep the raw token offline.
DITING_OWNER_TOKEN_HASH=<pbkdf2-sha256-placeholder>
DITING_SESSION_SECRET=<at-least-32-random-bytes-placeholder>
DITING_ALLOWED_ORIGINS=https://pittosporum.cloud

# Data and AI Providers
MX_APIKEY=
DITING_AI_ENABLED=false
AI_MODEL=deepseek/deepseek-v4-pro
AI_API_KEY=
DITING_SANDBOX_ENABLED=false

# Notifications are post-persist side effects and remain disabled unless configured.
NOTIFY_DEFAULT=local
