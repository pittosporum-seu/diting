# 谛听 · 环境变量
# 复制此文件为 .env 并填入真实值

# 运行层级: L0 | L1 | L2
DITING_LEVEL=L1

# 数据源
MX_APIKEY=

# AI Provider (LiteLLM — 支持 100+ provider)
AI_MODEL=deepseek/deepseek-v4-pro
AI_API_KEY=

# 沙箱 (sandboxmcp)
SANDBOX_BACKEND=process
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT=60

# 推送
NOTIFY_DEFAULT=local
FEISHU_APP_ID=
FEISHU_APP_SECRET=
EMAIL_SMTP_HOST=
EMAIL_FROM=
EMAIL_TO=

# 缓存 (秒)
CACHE_REALTIME_TTL=3600
CACHE_HISTORICAL_TTL=86400
CACHE_FINANCIALS_TTL=604800
